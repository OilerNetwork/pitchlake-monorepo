# Database Connections
FOSSIL_DB_URL=postgresql://fossil_user:fossil_password@localhost:5432/fossil
PITCHLAKE_DB_URL=postgresql://pitchlake_user:pitchlake_password@localhost:5433/pitchlake

# Database Users (for Docker setup)
FOSSIL_DB_USER=fossil_user
FOSSIL_DB_PASSWORD=fossil_password
PITCHLAKE_DB_USER=pitchlake_user
PITCHLAKE_DB_PASSWORD=pitchlake_password

# Ethereum Configuration
L1_ALCHEMY_URL=https://eth-mainnet.alchemyapi.io/v2/YOUR_API_KEY

# StarkNet Configuration
STARKNET_RPC=https://starknet-mainnet.infura.io/v3/YOUR_PROJECT_ID
STARKNET_PRIVATE_KEY=your_private_key_here
STARKNET_ACCOUNT_ADDRESS=your_account_address_here
VAULT_ADDRESSES=vault1_address,vault2_address,vault3_address

# Fossil API Configuration
FOSSIL_API_KEY=your_fossil_api_key_here
FOSSIL_API_URL=https://api.fossil.com

# Mock Verifier Configuration
USE_MOCK_VERIFIER=false  # Set to "true" to use mock verifier instead of Fossil API (uses automator's account as verifier)

# Cron Schedules
CRON_SCHEDULE=*/5 * * * * *  # Every 5 seconds for TWAP updates
CRON_SCHEDULE_STATE=*/30 * * * * *  # Every 30 seconds for state transitions

# TWAP Configuration
BLOCK_BATCH_SIZE=500  # Number of blocks to process in each batch (default: 500)
INITIAL_BLOCK_NUMBER=9263962

IS_DEVNET=false  # Set to "true" when running on devnet (katana) to mine blocks manually before each poll for accurate timestamps

# Logging
LOG_LEVEL=info

# Optional: Demo mode
USE_DEMO_DATA=false

