{
  "name": "support-server",
  "version": "1.0.0",
  "description": "Architecture Support Server - consolidated server combining alchemy-indexer, pitchlake-cron, and pitchlake-round-automator functionality",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:watch": "ts-node src/index.ts --watch --respawn",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts --ignore-pattern 'src/abi/**'",
    "lint:fix": "eslint src/**/*.ts --fix --ignore-pattern 'src/abi/**'",
    "format": "prettier --write src/**/*.ts --ignore-path 'src/abi/**'",
    "format:check": "prettier --check src/**/*.ts --ignore-path 'src/abi/**'"
  },
  "dependencies": {
    "@types/node-cron": "^3.0.11",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "node-cron": "^3.0.3",
    "pg": "^8.13.3",
    "pg-protocol": "^1.7.1",
    "starknet": "^7.6.4",
    "viem": "^2.23.10",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
